{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Schema version (must be 1)"
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "fingerprint": {
      "type": "string",
      "description": "Short hash of directory contents"
    },
    "semantic_fingerprint": {
      "description": "Semantic fingerprint (12-hex sha256) over exported API, imports, and policy facts",
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "scope": {
      "type": "string",
      "description": "Relative path from project root"
    },
    "summary": {
      "type": "string",
      "description": "1-3 sentence description of this directory"
    },
    "files": {
      "description": "Files in this directory",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Filename relative to this directory"
          },
          "purpose": {
            "type": "string",
            "description": "One-line description of what this file does"
          },
          "test_file": {
            "description": "Associated test file (heuristic, may be wrong for non-colocated test layouts)",
            "type": "string"
          }
        },
        "required": [
          "name",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "maintenance": {
      "type": "string",
      "description": "Self-describing update instruction for LLMs"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "API endpoint, function signature, or CLI command"
          },
          "description": {
            "type": "string",
            "description": "What this interface does"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "description": "The decision that was made"
          },
          "why": {
            "type": "string",
            "description": "Why this decision was made"
          },
          "tradeoff": {
            "description": "Known tradeoffs of this decision",
            "type": "string"
          }
        },
        "required": [
          "what",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "internal": {
          "description": "Internal module dependencies",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external": {
          "description": "External package dependencies",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "current_state": {
      "type": "object",
      "properties": {
        "working": {
          "description": "Things that are working",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "broken": {
          "description": "Things that are broken",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_progress": {
          "description": "Things in progress",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "subdirectories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Subdirectory name (with trailing /)"
          },
          "summary": {
            "type": "string",
            "description": "One-line summary of what this subdirectory contains"
          }
        },
        "required": [
          "name",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exports": {
      "description": "Compact method signatures and API surface",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imports": {
      "description": "Symbol-level import bindings from relative imports",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative import path (matches dependencies.internal entry)"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Imported symbol names, sorted alphabetically"
          }
        },
        "required": [
          "path",
          "symbols"
        ],
        "additionalProperties": false
      }
    },
    "internals": {
      "description": "Non-exported top-level declarations (full mode only)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Symbol name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "function",
              "class",
              "interface",
              "type",
              "constant",
              "enum"
            ]
          },
          "file": {
            "type": "string",
            "description": "Source filename within this directory"
          }
        },
        "required": [
          "name",
          "kind",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "One-line project description"
        },
        "language": {
          "type": "string",
          "description": "Primary language"
        },
        "framework": {
          "description": "Primary framework",
          "type": "string"
        },
        "package_manager": {
          "description": "Package manager used",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "language"
      ],
      "additionalProperties": false
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path from project root"
          },
          "summary": {
            "type": "string",
            "description": "One-line summary"
          }
        },
        "required": [
          "path",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "derived_fields": {
      "description": "Field paths that were machine-derived (high confidence)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "description": "Machine-collected code health evidence",
      "type": "object",
      "properties": {
        "collected_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of evidence collection"
        },
        "commit_sha": {
          "description": "Git commit SHA at time of evidence collection",
          "type": "string"
        },
        "test_status": {
          "type": "string",
          "enum": [
            "passing",
            "failing",
            "unknown"
          ]
        },
        "test_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "failing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_tool": {
          "description": "Test runner that produced the artifact (e.g. vitest, jest, pytest)",
          "type": "string"
        },
        "typecheck": {
          "type": "string",
          "enum": [
            "clean",
            "errors",
            "unknown"
          ]
        },
        "typecheck_tool": {
          "description": "Type checker that produced the artifact (e.g. tsc, mypy)",
          "type": "string"
        },
        "lint_status": {
          "type": "string",
          "enum": [
            "clean",
            "errors",
            "unknown"
          ]
        },
        "lint_tool": {
          "description": "Linter that produced the artifact (e.g. eslint, ruff)",
          "type": "string"
        },
        "coverage_percent": {
          "description": "Line coverage percentage",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "collected_at"
      ],
      "additionalProperties": false
    },
    "rules": {
      "description": "Typed policy rules enforced by `context validate --policy`",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "forbid_import"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ],
                "description": "Glob pattern, or non-empty array of patterns (leading '!' negates when inside an array)."
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ],
                "description": "Glob pattern, or non-empty array of patterns (leading '!' negates when inside an array)."
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "require_import"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ],
                "description": "Glob pattern, or non-empty array of patterns (leading '!' negates when inside an array)."
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ],
                "description": "Glob pattern, or non-empty array of patterns (leading '!' negates when inside an array)."
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "require_export"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "symbol_kind": {
                "description": "Optional symbol-kind filter. Named `symbol_kind` (not `kind`) to avoid collision with the rule discriminator.",
                "type": "string",
                "enum": [
                  "function",
                  "class",
                  "interface",
                  "type",
                  "constant",
                  "enum"
                ]
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "max_file_lines"
              },
              "value": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "exclude": {
                "description": "Globs of files excluded from the limit (last-match-wins when negated).",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "require_test_file"
              },
              "for": {
                "type": "string",
                "minLength": 1,
                "description": "Glob of source files that require a test file."
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "Test file pattern. Supports {name} and {ext} placeholders. Example: '{name}.test.{ext}'."
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "for",
              "pattern"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "dependency_boundary"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "allowed_to": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "from",
              "allowed_to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "evidence_requires"
              },
              "test_status": {
                "type": "string",
                "const": "passing"
              },
              "typecheck": {
                "type": "string",
                "const": "clean"
              },
              "lint_status": {
                "type": "string",
                "const": "clean"
              },
              "coverage_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "message": {
                "description": "Human-readable override for the default violation message.",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "last_updated",
    "fingerprint",
    "scope",
    "summary",
    "maintenance"
  ],
  "additionalProperties": false,
  "$id": "https://autocontext.dev/schema/v1/context.json",
  "title": ".context.yaml",
  "description": "Schema for autocontext directory-level context files (v1)"
}
